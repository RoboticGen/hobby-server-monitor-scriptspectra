[Unit]
Description=Hobby Server Monitor - Falcon API Backend
After=network.target lxd.service

[Service]
Type=simple
User=sachini
WorkingDirectory=/home/sachini/projects/hobby-server-monitor-scriptspectra/backend
ExecStart=/home/sachini/projects/hobby-server-monitor-scriptspectra/backend/.venv/bin/gunicorn app.main:application -w 2 -b 0.0.0.0:8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
