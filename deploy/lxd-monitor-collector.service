[Unit]
Description=LXD Monitor Collector (independent metric poller)
After=network.target
# Intentionally does NOT depend on lxd-monitor-backend.
# The collector runs independently — metric continuity is guaranteed
# even while the backend restarts.

[Service]
User=lxd-monitor
Group=lxd
WorkingDirectory=/opt/lxd-monitor/backend
EnvironmentFile=/opt/lxd-monitor/.env
ExecStart=/opt/lxd-monitor/venv/bin/python -m collector.main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lxd-monitor-collector

[Install]
WantedBy=multi-user.target
