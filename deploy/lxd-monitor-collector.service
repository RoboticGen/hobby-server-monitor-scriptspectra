[Unit]
Description=Hobby Server Monitor - LXD Metrics Collector Daemon
After=network.target lxd.service

[Service]
Type=simple
User=sachini
WorkingDirectory=/home/sachini/projects/hobby-server-monitor-scriptspectra/backend
ExecStart=/home/sachini/projects/hobby-server-monitor-scriptspectra/backend/.venv/bin/python -m collector.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
