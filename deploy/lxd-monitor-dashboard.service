[Unit]
Description=Hobby Server Monitor - Astro SSR Dashboard
After=network.target lxd-monitor-backend.service

[Service]
Type=simple
User=sachini
WorkingDirectory=/home/sachini/projects/hobby-server-monitor-scriptspectra/dashboard
ExecStart=/home/sachini/.nvm/versions/node/v22.23.2/bin/npm run dev
Restart=always
RestartSec=5
Environment=PORT=4321
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
