# ─────────────────────────────────────────────────────────────────────────────
# Hobby Server Monitor — Environment Configuration
# Copy this file to .env and fill in the values.
# The .env file is git-ignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:8000/auth/google/callback (dev)
#                          https://your-domain.com/auth/google/callback (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Session Security ──────────────────────────────────────────────────────────
# Random 32+ byte hex string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-random-64-char-hex-string

# ── Bootstrap Admin ───────────────────────────────────────────────────────────
# This Google account email will always be granted admin role.
# The "first user wins" fallback fires once and then self-disables.
BOOTSTRAP_ADMIN_EMAIL=your@email.com

# ── Data Paths ────────────────────────────────────────────────────────────────
# Relative to project root. The data/ directory is git-ignored.
# Created automatically at startup if absent.
SQLITE_DB_PATH=data/app.db
TINYFLUX_DB_PATH=data/metrics.tinyflux

# ── LXD Connection ────────────────────────────────────────────────────────────
# Leave blank to use the Unix socket (recommended when running on the same host).
# The OS user running the backend must be in the 'lxd' group.
# Set to https://host:8443 only for remote LXD instances.
LXD_ENDPOINT=

# ── Collector ─────────────────────────────────────────────────────────────────
COLLECTOR_POLL_INTERVAL_SECONDS=10
METRICS_RETENTION_DAYS=30

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Environment ───────────────────────────────────────────────────────────────
# 'development' → cookie Secure flag OFF (plain HTTP localhost OK)
# 'production'  → cookie Secure flag ON  (requires HTTPS)
APP_ENV=development






^^^^^^X
^x
^X
exit

