---
// dashboard/src/pages/containers/detail.astro
// Live Telemetry & Historical Time-Series Metric Visualization with Chart.js
const sessionCookie = Astro.cookies.get('session_token');

if (!sessionCookie || !sessionCookie.value) {
  return Astro.redirect('/');
}

let user = null;
let containerName = Astro.url.searchParams.get('container') || '';
let containerData = null;
let liveMetricsData = null;

if (!containerName) {
  return Astro.redirect('/dashboard');
}

try {
  // 1. Verify user profile
  const userRes = await fetch('http://localhost:8000/api/me', {
    headers: { Cookie: `session_token=${sessionCookie.value}` }
  });
  if (!userRes.ok) return Astro.redirect('/');
  const userData = await userRes.json();
  user = userData.user;

  // 2. Fetch container detail
  const cRes = await fetch(`http://localhost:8000/api/containers/${encodeURIComponent(containerName)}`, {
    headers: { Cookie: `session_token=${sessionCookie.value}` }
  });
  if (!cRes.ok) return Astro.redirect('/dashboard');
  const cData = await cRes.json();
  containerData = cData.container;

  // 3. Fetch live metrics
  const liveRes = await fetch(`http://localhost:8000/api/metrics/${encodeURIComponent(containerName)}/live`, {
    headers: { Cookie: `session_token=${sessionCookie.value}` }
  });
  if (liveRes.ok) {
    const rawLive = await liveRes.json();
    liveMetricsData = rawLive.metrics || rawLive;
  }
} catch (e) {
  return Astro.redirect('/dashboard');
}

const isAdmin = user.role === 'admin';
const limits = containerData?.limits || { ram_mb: 512, cpu_cores: 1, disk_gb: 5 };
const lm = liveMetricsData || {};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{containerName} Telemetry — Server Monitor</title>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      :root {
        --bg: #0d0f14;
        --surface: #161922;
        --surface-hover: #1e2230;
        --border: #262b38;
        --text: #f3f4f6;
        --muted: #9ca3af;
        --accent: #6366f1;
        --accent-hover: #4f46e5;
        --green: #22c55e;
        --purple: #a855f7;
        --amber: #f59e0b;
        --red: #ef4444;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
      }
      header {
        background-color: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: flex; align-items: center; gap: 0.75rem; font-weight: 700; font-size: 1.2rem;
      }
      .brand-icon {
        width: 32px; height: 32px;
        background: linear-gradient(135deg, var(--accent), var(--purple));
        border-radius: 8px; display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.1rem;
      }
      .nav-links { display: flex; align-items: center; gap: 1.5rem; margin-left: 2rem; }
      .nav-item { color: var(--muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
      .nav-item:hover, .nav-item.active { color: var(--text); }
      main { max-width: 1150px; margin: 2rem auto; padding: 0 1.5rem; }

      .detail-header {
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.75rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .detail-title { font-size: 1.6rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem; }
      .status-badge {
        font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 999px; text-transform: uppercase;
      }
      .status-running { background-color: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
      .status-stopped { background-color: rgba(107, 114, 128, 0.15); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3); }

      .telemetry-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        margin-bottom: 2rem;
      }
      .t-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.25rem;
      }
      .t-label { font-size: 0.8rem; color: var(--muted); margin-bottom: 0.4rem; font-weight: 600; }
      .t-val { font-size: 1.35rem; font-weight: 700; color: var(--text); }
      .t-sub { font-size: 0.78rem; color: var(--muted); margin-top: 0.3rem; }

      .timeframe-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
      }
      .tf-buttons { display: flex; gap: 0.5rem; background: var(--surface); padding: 0.3rem; border-radius: 8px; border: 1px solid var(--border); }
      .tf-btn {
        background: none; border: none; color: var(--muted); padding: 0.4rem 0.9rem;
        border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.15s;
      }
      .tf-btn.active { background: var(--accent); color: white; }

      .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
      .chart-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
      }
      .chart-title { font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--text); }
      .chart-wrapper { height: 240px; position: relative; }
      .btn-terminal {
        display: inline-flex; align-items: center; gap: 0.4rem; background: var(--accent); color: white;
        padding: 0.6rem 1.25rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-decoration: none;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="brand">
        <div class="brand-icon">⚡</div>
        <span>Server Monitor</span>
      </div>
      <nav class="nav-links">
        <a href="/dashboard" class="nav-item">Dashboard</a>
        {isAdmin ? <a href="/users" class="nav-item">User Management</a> : <a href="/account" class="nav-item">My Quotas</a>}
        {isAdmin ? <a href="/audit" class="nav-item">Audit Logs</a> : null}
      </nav>
    </header>

    <main>
      <!-- Detail Header -->
      <div class="detail-header">
        <div>
          <div class="detail-title">
            <span>{containerName}</span>
            <span class={`status-badge ${containerData?.lxd_status === 'Running' ? 'status-running' : 'status-stopped'}`}>
              {containerData?.lxd_status || 'Unknown'}
            </span>
          </div>
          <div style="color: var(--muted); font-size: 0.88rem; margin-top: 0.4rem;">
            {containerData?.description || 'No description provided.'}
          </div>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <a href={`/terminal?container=${encodeURIComponent(containerName)}`} class="btn-terminal">
            <span>>_</span> Launch Terminal
          </a>
          <a href="/dashboard" style="color: var(--muted); text-decoration: none; font-size: 0.88rem; margin-left: 0.5rem;">← Dashboard</a>
        </div>
      </div>

      <!-- Real-Time Telemetry Cards -->
      <div class="telemetry-grid">
        <div class="t-card">
          <div class="t-label">CPU Usage</div>
          <div class="t-val" id="liveCpu">{lm.cpu_percent !== undefined ? lm.cpu_percent.toFixed(1) + '%' : '0.0%'}</div>
          <div class="t-sub">Allocated: {limits.cpu_cores} Core(s)</div>
        </div>

        <div class="t-card">
          <div class="t-label">RAM Usage</div>
          <div class="t-val" id="liveRam">{lm.ram_used_mb !== undefined ? lm.ram_used_mb.toFixed(0) + ' MB' : '0 MB'}</div>
          <div class="t-sub">Allocated: {limits.ram_mb} MB</div>
        </div>

        <div class="t-card">
          <div class="t-label">Disk Storage</div>
          <div class="t-val" id="liveDisk">{lm.disk_used_gb !== undefined ? lm.disk_used_gb.toFixed(1) + ' GB' : '0 GB'}</div>
          <div class="t-sub">Allocated: {limits.disk_gb} GB</div>
        </div>

        <div class="t-card">
          <div class="t-label">Network I/O Rate</div>
          <div class="t-val" id="liveNet">{lm.net_rx_rate_bps !== undefined ? (lm.net_rx_rate_bps / 1024).toFixed(1) + ' KB/s' : '0.0 KB/s'}</div>
          <div class="t-sub">Processes: <strong id="liveProc" style="color:var(--text);">{lm.process_count || containerData?.lxd_state?.processes || 0}</strong></div>
        </div>
      </div>

      <!-- Timeframe Controls -->
      <div class="timeframe-bar">
        <h2 style="font-size: 1.25rem; font-weight: 700;">Historical Time-Series Metrics</h2>
        <div class="tf-buttons">
          <button class="tf-btn active" data-period="1h">1 Hour</button>
          <button class="tf-btn" data-period="6h">6 Hours</button>
          <button class="tf-btn" data-period="24h">24 Hours</button>
          <button class="tf-btn" data-period="7d">7 Days</button>
        </div>
      </div>

      <!-- Chart.js Line Graphs -->
      <div class="charts-grid">
        <div class="chart-card">
          <div class="chart-title">CPU Utilization (%)</div>
          <div class="chart-wrapper"><canvas id="cpuChart"></canvas></div>
        </div>

        <div class="chart-card">
          <div class="chart-title">RAM Consumption (MB)</div>
          <div class="chart-wrapper"><canvas id="ramChart"></canvas></div>
        </div>

        <div class="chart-card">
          <div class="chart-title">Disk Storage Usage (GB)</div>
          <div class="chart-wrapper"><canvas id="diskChart"></canvas></div>
        </div>

        <div class="chart-card">
          <div class="chart-title">Network Throughput (KB/s)</div>
          <div class="chart-wrapper"><canvas id="netChart"></canvas></div>
        </div>
      </div>
    </main>

    <script define:vars={{ containerName }}>
      let activePeriod = '1h';
      let charts = {};

      const chartConfig = (label, color) => ({
        type: 'line',
        data: { labels: [], datasets: [{ label, data: [], borderColor: color, backgroundColor: color + '1a', borderWidth: 2, tension: 0.3, fill: true, pointRadius: 1 }] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: '#262b38' }, ticks: { color: '#9ca3af', font: { size: 10 } } },
            y: { grid: { color: '#262b38' }, ticks: { color: '#9ca3af', font: { size: 10 } }, beginAtZero: true }
          }
        }
      });

      function initCharts() {
        charts.cpu = new Chart(document.getElementById('cpuChart'), chartConfig('CPU %', '#6366f1'));
        charts.ram = new Chart(document.getElementById('ramChart'), chartConfig('RAM MB', '#a855f7'));
        charts.disk = new Chart(document.getElementById('diskChart'), chartConfig('Disk GB', '#f59e0b'));
        charts.net = new Chart(document.getElementById('netChart'), chartConfig('Network KB/s', '#22c55e'));
      }

      async function fetchHistory(period) {
        try {
          const res = await fetch(`/api/metrics/${encodeURIComponent(containerName)}/history?period=${period}`, { credentials: 'include' });
          if (!res.ok) return;
          const data = await res.json();
          const samples = data.samples || data.history || [];

          const labels = samples.map(p => {
            const d = new Date(p.timestamp);
            return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          });

          const cpuData = samples.map(p => p.cpu_percent !== undefined ? p.cpu_percent : (p.cpu_pct || 0));
          const ramData = samples.map(p => p.ram_used_mb !== undefined ? p.ram_used_mb : (p.memory_mb || 0));
          const diskData = samples.map(p => p.disk_used_gb !== undefined ? p.disk_used_gb : (p.disk_gb || 0));
          const netData = samples.map(p => {
            const rate = p.net_rx_rate_bps !== undefined ? p.net_rx_rate_bps : (p.net_rx_bps || 0);
            return (rate / 1024).toFixed(1);
          });

          updateChart(charts.cpu, labels, cpuData);
          updateChart(charts.ram, labels, ramData);
          updateChart(charts.disk, labels, diskData);
          updateChart(charts.net, labels, netData);
        } catch (e) {
          console.error('Failed to fetch metric history:', e);
        }
      }

      function updateChart(chart, labels, data) {
        chart.data.labels = labels;
        chart.data.datasets[0].data = data;
        chart.update();
      }

      document.addEventListener('DOMContentLoaded', () => {
        initCharts();
        fetchHistory(activePeriod);

        document.querySelectorAll('.tf-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activePeriod = btn.getAttribute('data-period');
            fetchHistory(activePeriod);
          });
        });
      });
    </script>
  </body>
</html>
