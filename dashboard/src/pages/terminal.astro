---
// dashboard/src/pages/terminal.astro
// Authenticated, authorized, audited in-browser container terminal
// Redirects to / if not logged in, to /dashboard if user lacks container access

const sessionCookie = Astro.cookies.get('session_token');
if (!sessionCookie || !sessionCookie.value) {
  return Astro.redirect('/');
}

let user = null;
let containerName = Astro.url.searchParams.get('container') || '';
let accessDenied = false;
let containerNotFound = false;

try {
  const userRes = await fetch('http://localhost:8000/api/me', {
    headers: { Cookie: `session_token=${sessionCookie.value}` }
  });
  if (!userRes.ok) return Astro.redirect('/');
  const userData = await userRes.json();
  user = userData.user;
} catch (e) {
  return Astro.redirect('/');
}

// Validate the container name is provided
if (!containerName) {
  return Astro.redirect('/dashboard');
}

// For standard users, verify they have access by trying to fetch live metrics
// (which applies the same assignment check as exec will)
if (user.role !== 'admin') {
  try {
    const checkRes = await fetch(`http://localhost:8000/api/metrics/${containerName}/live`, {
      headers: { Cookie: `session_token=${sessionCookie.value}` }
    });
    if (checkRes.status === 403) {
      accessDenied = true;
    } else if (checkRes.status === 404) {
      containerNotFound = true;
    }
  } catch (e) {
    containerNotFound = true;
  }
}

if (accessDenied || containerNotFound) {
  return Astro.redirect('/dashboard');
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminal — {containerName} — Server Monitor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #0a0c10;
        --surface: #111318;
        --surface2: #171b22;
        --border: #1f2533;
        --text: #e2e8f0;
        --muted: #6b7280;
        --accent: #6366f1;
        --accent-glow: rgba(99,102,241,0.25);
        --green: #22c55e;
        --green-dim: rgba(34,197,94,0.15);
        --red: #ef4444;
        --red-dim: rgba(239,68,68,0.15);
        --yellow: #f59e0b;
        --cyan: #22d3ee;
        --mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
        --sans: 'Inter', system-ui, sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* ── Header ────────────────────────────────────────────────────── */
      .header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 1rem;
      }

      .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--border);
        transition: color 0.15s, border-color 0.15s;
      }
      .back-btn:hover { color: var(--text); border-color: var(--accent); }

      .container-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--mono);
        font-size: 0.95rem;
        font-weight: 600;
      }

      .container-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 8px var(--green);
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .role-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: rgba(99,102,241,0.15);
        color: #818cf8;
        border: 1px solid rgba(99,102,241,0.3);
      }

      /* ── Terminal container ────────────────────────────────────────── */
      .terminal-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 1rem 1.25rem;
        gap: 0.75rem;
      }

      .terminal-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
        color: var(--muted);
        flex-shrink: 0;
      }

      .info-chip {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25rem 0.65rem;
        font-family: var(--mono);
        font-size: 0.75rem;
      }

      /* ── Output area ───────────────────────────────────────────────── */
      .terminal-output {
        flex: 1;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1rem 1.25rem;
        overflow-y: auto;
        font-family: var(--mono);
        font-size: 0.83rem;
        line-height: 1.6;
        scroll-behavior: smooth;
        position: relative;
      }

      .terminal-output::-webkit-scrollbar { width: 6px; }
      .terminal-output::-webkit-scrollbar-track { background: transparent; }
      .terminal-output::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

      /* Welcome banner inside terminal */
      .terminal-welcome {
        color: var(--cyan);
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
      }

      .terminal-welcome pre {
        line-height: 1.4;
        white-space: pre;
        font-size: 0.78rem;
        color: #6366f1;
        opacity: 0.8;
      }

      /* Individual command blocks */
      .cmd-block {
        margin-bottom: 1.25rem;
        animation: fadeIn 0.2s ease;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .cmd-prompt-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
        color: var(--cyan);
      }

      .cmd-prompt-symbol { color: var(--accent); font-weight: 700; }
      .cmd-text { color: var(--text); }

      .exit-badge {
        margin-left: auto;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.1rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.04em;
      }
      .exit-ok { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,197,94,0.3); }
      .exit-err { background: var(--red-dim); color: var(--red); border: 1px solid rgba(239,68,68,0.3); }

      .cmd-stdout {
        white-space: pre-wrap;
        word-break: break-all;
        color: var(--text);
      }

      .cmd-stderr {
        white-space: pre-wrap;
        word-break: break-all;
        color: #fca5a5;
      }

      .cmd-truncated {
        margin-top: 0.35rem;
        font-size: 0.75rem;
        color: var(--yellow);
        font-style: italic;
      }

      /* Error/status messages */
      .msg-error {
        color: var(--red);
        padding: 0.4rem 0;
      }

      .msg-info {
        color: var(--muted);
        padding: 0.4rem 0;
        font-style: italic;
      }

      /* ── Input area ────────────────────────────────────────────────── */
      .terminal-input-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.6rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
        transition: border-color 0.2s;
      }

      .terminal-input-wrap:focus-within {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }

      .prompt-prefix {
        font-family: var(--mono);
        font-size: 0.9rem;
        color: var(--accent);
        font-weight: 700;
        flex-shrink: 0;
        user-select: none;
      }

      #cmdInput {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.88rem;
        caret-color: var(--accent);
      }

      #cmdInput::placeholder { color: var(--muted); }

      .run-btn {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.4rem 1rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.82rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
        transition: background 0.15s, opacity 0.15s;
      }

      .run-btn:hover { background: #4f46e5; }
      .run-btn:disabled { opacity: 0.45; cursor: not-allowed; }

      .clear-btn {
        color: var(--muted);
        background: transparent;
        border: 1px solid var(--border);
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        flex-shrink: 0;
        transition: color 0.15s, border-color 0.15s;
      }

      .clear-btn:hover { color: var(--text); border-color: var(--accent); }

      .char-count {
        font-size: 0.75rem;
        color: var(--muted);
        font-family: var(--mono);
        flex-shrink: 0;
        min-width: 4rem;
        text-align: right;
      }
      .char-count.warn { color: var(--yellow); }
      .char-count.danger { color: var(--red); }

      /* ── Spinner ────────────────────────────────────────────────────── */
      .spinner {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.2);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>

  <body>
    <!-- Header -->
    <header class="header">
      <div class="header-left">
        <a href="/dashboard" class="back-btn">← Dashboard</a>
        <div class="container-label">
          <div class="container-dot"></div>
          {containerName}
        </div>
        <div class="info-chip">/bin/sh</div>
      </div>
      <div class="header-right">
        <span id="userLabel">{user.name || user.email}</span>
        <span class="role-badge">{user.role}</span>
      </div>
    </header>

    <!-- Terminal body -->
    <div class="terminal-wrap">

      <!-- Security info chips -->
      <div class="terminal-info">
        <span>Security controls:</span>
        <span class="info-chip">Auth ✓</span>
        <span class="info-chip">RBAC ✓</span>
        <span class="info-chip">Assigned ✓</span>
        <span class="info-chip">512-char cap</span>
        <span class="info-chip">30s timeout</span>
        <span class="info-chip">64KB truncation</span>
        <span class="info-chip">Audit logged</span>
      </div>

      <!-- Output scroll area -->
      <div class="terminal-output" id="terminalOutput">
        <div class="terminal-welcome">
          <pre>╔══════════════════════════════════════════════════════╗
║      Server Monitor — Container Terminal             ║
╚══════════════════════════════════════════════════════╝</pre>
          <div style="margin-top: 0.5rem; color: var(--muted); font-size: 0.8rem;">
            Connected to container: <span style="color: var(--cyan)">{containerName}</span><br/>
            Shell: <span style="color: var(--yellow)">/bin/sh -c &lt;command&gt;</span> &nbsp;|&nbsp; Every command is audit logged.<br/>
            Tip: Press <kbd style="background:var(--surface2); border:1px solid var(--border); padding:0.1rem 0.3rem; border-radius:3px;">↑</kbd> / <kbd style="background:var(--surface2); border:1px solid var(--border); padding:0.1rem 0.3rem; border-radius:3px;">↓</kbd> to browse command history.
          </div>
        </div>
        <div id="cmdHistory"></div>
      </div>

      <!-- Input row -->
      <div class="terminal-input-wrap">
        <span class="prompt-prefix">{containerName} $</span>
        <input
          id="cmdInput"
          type="text"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          maxlength="512"
          placeholder="Enter command… (e.g.  ls -la  or  cat /etc/os-release)"
          autofocus
        />
        <span class="char-count" id="charCount">0 / 512</span>
        <button class="clear-btn" id="clearBtn" type="button">Clear</button>
        <button class="run-btn" id="runBtn" type="button">
          <div class="spinner" id="spinner"></div>
          <span id="runLabel">Run</span>
        </button>
      </div>

    </div>

    <script define:vars={{ containerName }}>
      const output = document.getElementById('terminalOutput');
      const history = document.getElementById('cmdHistory');
      const input = document.getElementById('cmdInput');
      const runBtn = document.getElementById('runBtn');
      const clearBtn = document.getElementById('clearBtn');
      const spinner = document.getElementById('spinner');
      const runLabel = document.getElementById('runLabel');
      const charCount = document.getElementById('charCount');

      let cmdHistory = [];
      let historyIndex = -1;
      let isRunning = false;

      // ── Character counter ──────────────────────────────────────────────
      input.addEventListener('input', () => {
        const len = input.value.length;
        charCount.textContent = `${len} / 512`;
        charCount.className = 'char-count' + (len >= 512 ? ' danger' : len > 400 ? ' warn' : '');
      });

      // ── Command history navigation (up/down arrows) ────────────────────
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !isRunning) {
          e.preventDefault();
          executeCommand();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (historyIndex < cmdHistory.length - 1) {
            historyIndex++;
            input.value = cmdHistory[cmdHistory.length - 1 - historyIndex];
            input.dispatchEvent(new Event('input'));
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (historyIndex > 0) {
            historyIndex--;
            input.value = cmdHistory[cmdHistory.length - 1 - historyIndex];
          } else {
            historyIndex = -1;
            input.value = '';
          }
          input.dispatchEvent(new Event('input'));
        }
      });

      runBtn.addEventListener('click', () => { if (!isRunning) executeCommand(); });
      clearBtn.addEventListener('click', () => {
        history.innerHTML = '';
        input.value = '';
        input.dispatchEvent(new Event('input'));
        input.focus();
      });

      // ── Execute command ────────────────────────────────────────────────
      async function executeCommand() {
        const cmd = input.value.trim();
        if (!cmd) return;

        isRunning = true;
        runBtn.disabled = true;
        spinner.style.display = 'block';
        runLabel.textContent = '...';
        input.disabled = true;

        // Add to in-memory history (most recent at end)
        if (cmdHistory.length === 0 || cmdHistory[cmdHistory.length - 1] !== cmd) {
          cmdHistory.push(cmd);
          if (cmdHistory.length > 100) cmdHistory.shift();
        }
        historyIndex = -1;
        input.value = '';
        input.dispatchEvent(new Event('input'));

        const block = document.createElement('div');
        block.className = 'cmd-block';

        try {
          const res = await fetch(`/api/terminal/${containerName}/exec`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ command: cmd }),
          });

          const data = await res.json();

          if (!res.ok) {
            // API-level error (400, 403, 404, 409, 500…)
            const errTitle = data.title || `Error ${res.status}`;
            const errDesc = data.description || 'An unexpected error occurred.';
            block.innerHTML = `
              <div class="cmd-prompt-line">
                <span class="cmd-prompt-symbol">$</span>
                <span class="cmd-text">${escHtml(cmd)}</span>
                <span class="exit-badge exit-err">HTTP ${res.status}</span>
              </div>
              <div class="cmd-stderr">${escHtml(errTitle + ': ' + errDesc)}</div>
            `;
          } else {
            const exitOk = data.exit_code === 0;
            const stdoutHtml = data.stdout
              ? `<div class="cmd-stdout">${escHtml(data.stdout)}</div>`
              : '';
            const stderrHtml = data.stderr
              ? `<div class="cmd-stderr">${escHtml(data.stderr)}</div>`
              : '';
            const truncHtml = data.truncated
              ? `<div class="cmd-truncated">⚠ Output truncated at 64 KB</div>`
              : '';

            block.innerHTML = `
              <div class="cmd-prompt-line">
                <span class="cmd-prompt-symbol">$</span>
                <span class="cmd-text">${escHtml(cmd)}</span>
                <span class="exit-badge ${exitOk ? 'exit-ok' : 'exit-err'}">
                  exit ${data.exit_code}
                </span>
              </div>
              ${stdoutHtml}${stderrHtml}${truncHtml}
            `;
          }
        } catch (err) {
          block.innerHTML = `
            <div class="cmd-prompt-line">
              <span class="cmd-prompt-symbol">$</span>
              <span class="cmd-text">${escHtml(cmd)}</span>
              <span class="exit-badge exit-err">Network Error</span>
            </div>
            <div class="cmd-stderr">${escHtml(String(err))}</div>
          `;
        }

        history.appendChild(block);
        output.scrollTop = output.scrollHeight;

        isRunning = false;
        runBtn.disabled = false;
        spinner.style.display = 'none';
        runLabel.textContent = 'Run';
        input.disabled = false;
        input.focus();
      }

      // ── HTML escaping ──────────────────────────────────────────────────
      function escHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }
    </script>
  </body>
</html>
