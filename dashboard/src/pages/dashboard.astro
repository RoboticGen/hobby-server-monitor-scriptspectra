---
// dashboard/src/pages/dashboard.astro
// SSR server-side session & role verification against Falcon backend
const sessionCookie = Astro.cookies.get('session_token');

if (!sessionCookie || !sessionCookie.value) {
  return Astro.redirect('/');
}

let user = null;
let containers = [];

try {
  // 1. Fetch authenticated user profile & role
  const userRes = await fetch('http://localhost:8000/api/me', {
    headers: {
      Cookie: `session_token=${sessionCookie.value}`
    }
  });

  if (!userRes.ok) {
    return Astro.redirect('/');
  }

  const userData = await userRes.json();
  user = userData.user;

  // 2. Fetch container list for role view
  const containersRes = await fetch('http://localhost:8000/api/containers', {
    headers: {
      Cookie: `session_token=${sessionCookie.value}`
    }
  });

  if (containersRes.ok) {
    const cData = await containersRes.json();
    containers = cData.containers || [];
  }
} catch (err) {
  return Astro.redirect('/');
}

const isAdmin = user.role === 'admin';
const quota = user.quotas || { ram_mb: 2048, cpu_cores: 2, disk_gb: 20 };
const used = user.used || { ram_mb: 0, cpu_cores: 0, disk_gb: 0 };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{isAdmin ? 'Admin Dashboard' : 'User Dashboard'} — Server Monitor</title>
    <style>
      :root {
        --bg: #0d0f14;
        --surface: #161922;
        --surface-hover: #1e2230;
        --border: #262b38;
        --text: #f3f4f6;
        --muted: #9ca3af;
        --accent: #6366f1;
        --accent-hover: #4f46e5;
        --green: #22c55e;
        --purple: #a855f7;
        --amber: #f59e0b;
        --red: #ef4444;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        min-height: 100vh;
      }
      header {
        background-color: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.2rem;
      }
      .brand-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, var(--accent), var(--purple));
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-left: 2rem;
      }
      .nav-item {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }
      .nav-item:hover, .nav-item.active {
        color: var(--text);
      }
      .user-profile {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid var(--border);
      }
      .badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .badge-admin { background-color: rgba(168, 85, 247, 0.25); color: #d8b4fe; border: 1px solid rgba(168, 85, 247, 0.5); }
      .badge-user { background-color: rgba(99, 102, 241, 0.25); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.5); }
      .btn-logout {
        background-color: transparent;
        border: 1px solid var(--border);
        color: var(--muted);
        padding: 0.4rem 0.9rem;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-logout:hover {
        background-color: #ef4444;
        color: white;
        border-color: #ef4444;
      }
      main {
        max-width: 1150px;
        margin: 2rem auto;
        padding: 0 1.5rem;
      }
      .header-banner {
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.75rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .header-banner h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.3rem; }
      .header-banner p { color: var(--muted); font-size: 0.95rem; }

      .quota-pills {
        display: flex;
        gap: 1rem;
        margin-top: 0.75rem;
        font-size: 0.85rem;
      }
      .quota-pill {
        background: rgba(38, 43, 56, 0.6);
        border: 1px solid var(--border);
        padding: 0.3rem 0.75rem;
        border-radius: 6px;
        color: var(--muted);
      }
      .quota-pill strong { color: var(--text); }

      .action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
      }
      .btn-primary {
        background-color: var(--accent);
        color: white;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: background-color 0.2s;
      }
      .btn-primary:hover { background-color: var(--accent-hover); }

      .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
      }
      .card {
        background-color: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: border-color 0.2s;
      }
      .card:hover { border-color: #3b4254; }
      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }
      .card-title { font-size: 1.1rem; font-weight: 700; color: var(--text); }
      .status-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }
      .status-running { background-color: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
      .status-stopped { background-color: rgba(107, 114, 128, 0.15); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3); }
      .status-frozen { background-color: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

      .limits-list {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--muted);
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border);
      }
      .card-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border);
      }
      .btn-terminal {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(99,102,241,0.12);
        color: #818cf8;
        border: 1px solid rgba(99,102,241,0.3);
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s, border-color 0.15s;
        font-family: 'Courier New', monospace;
      }
      .btn-terminal:hover { background: rgba(99,102,241,0.25); border-color: rgba(99,102,241,0.6); }
      .empty-state {
        background-color: var(--surface);
        border: 1px dashed var(--border);
        border-radius: 12px;
        padding: 3rem;
        text-align: center;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <div style="display: flex; align-items: center;">
        <div class="brand">
          <div class="brand-icon">?</div>
          <span>Server Monitor</span>
        </div>
        <nav class="nav-links">
          <a href="/dashboard" class="nav-item active">Dashboard</a>
          {isAdmin ? (
            <a href="/users" class="nav-item">User Management</a>
          ) : (
            <a href="/account" class="nav-item">My Quotas</a>
          )}
        </nav>
      </div>
      <div class="user-profile">
        {user.picture_url && <img src={user.picture_url} alt={user.name} class="avatar" />}
        <div style="text-align: right;">
          <div style="font-weight: 600; font-size: 0.88rem;">{user.name || user.email}</div>
          <span class={`badge ${isAdmin ? 'badge-admin' : 'badge-user'}`}>
            {user.role}
          </span>
        </div>
        <button id="logoutBtn" class="btn-logout">Sign out</button>
      </div>
    </header>

    <main>
      <!-- Role-Specific Banner -->
      <div class="header-banner">
        <div>
          <h1>{isAdmin ? 'Administrator Dashboard' : 'User Container Dashboard'}</h1>
          <p>
            {isAdmin
              ? 'Full control over LXD containers, hypervisor host allocations, and user accounts.'
              : 'View and manage your assigned LXD containers and resource quotas.'}
          </p>

          {!isAdmin && (
            <div class="quota-pills">
              <div class="quota-pill">RAM: <strong>{used.ram_mb} / {quota.ram_mb} MB</strong></div>
              <div class="quota-pill">CPU: <strong>{used.cpu_cores} / {quota.cpu_cores} Cores</strong></div>
              <div class="quota-pill">Disk: <strong>{used.disk_gb} / {quota.disk_gb} GB</strong></div>
            </div>
          )}
        </div>
        <div>
          <span class={`badge ${isAdmin ? 'badge-admin' : 'badge-user'}`} style="font-size: 0.85rem; padding: 0.4rem 0.9rem;">
            Role: {user.role.toUpperCase()}
          </span>
        </div>
      </div>

      <!-- Action Bar -->
      <div class="action-bar">
        <h2 style="font-size: 1.25rem; font-weight: 700;">
          {isAdmin ? 'All Managed LXD Containers' : 'My Assigned Containers'}
        </h2>

        <a href="/containers/create" class="btn-primary">
          <span>+</span> Create Container
        </a>
      </div>

      <!-- Containers Grid -->
      {containers.length > 0 ? (
        <div class="grid-container">
          {containers.map((c) => (
            <div class="card">
              <div class="card-header">
                <span class="card-title">{c.name}</span>
                <span class={`status-badge ${c.status === 'Running' ? 'status-running' : c.status === 'Frozen' ? 'status-frozen' : 'status-stopped'}`}>
                  {c.status}
                </span>
              </div>
              
              <div style="font-size: 0.85rem; color: var(--muted); min-height: 2.2em;">
                {c.description || 'No description provided.'}
              </div>

              <div class="limits-list">
                <div>RAM: <strong>{c.limits?.ram_mb || 512} MB</strong></div>
                <div>CPU: <strong>{c.limits?.cpu_cores || 1} Core</strong></div>
                <div>Disk: <strong>{c.limits?.disk_gb || 5} GB</strong></div>
              </div>

              <div class="card-actions">
                <a href={`/terminal?container=${encodeURIComponent(c.name)}`} class="btn-terminal">
                  <span>>_</span> Terminal
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text);">No Containers Available</h3>
          <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">
            {isAdmin
              ? 'Get started by creating your first LXD container.'
              : 'You have no assigned LXD containers yet. Click below to create one within your quota budget.'}
          </p>
          <a href="/containers/create" class="btn-primary">
            <span>+</span> Create Container
          </a>
        </div>
      )}
    </main>

    <script>
      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/auth/logout', { method: 'POST', credentials: 'include' });
          } finally {
            window.location.href = '/';
          }
        });
      }
    </script>
  </body>
</html>
